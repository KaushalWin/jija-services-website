{
  "name": "jija-services-website",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "bash scripts/build-static.sh",
    "build:worker": "esbuild src/worker.js --bundle --format=esm --platform=browser --outfile=.worker-test/worker.mjs",
    "test": "npm run build:worker && node --test tests/*.test.js",
    "test:ui": "npm run build && node tests/ui-review.mjs"
  },
  "dependencies": { "jose": "6.2.12" },
  "devDependencies": { "esbuild": "0.28.2", "miniflare": "5.20261001.0-alpha", "wrangler": "4.147.0", "playwright": "1.63.0" }
}
